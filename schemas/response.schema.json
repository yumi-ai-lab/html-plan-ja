{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HTML Plan JA response draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "projectId",
    "planId",
    "planRevision",
    "answers",
    "comments"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1"
    },
    "projectId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$",
      "maxLength": 100
    },
    "planId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$",
      "maxLength": 100
    },
    "planRevision": {
      "type": "integer",
      "minimum": 1
    },
    "answers": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "decisionId",
          "status",
          "optionId",
          "reviewedAt"
        ],
        "properties": {
          "decisionId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$",
            "maxLength": 100
          },
          "status": {
            "enum": [
              "unanswered",
              "selected",
              "deferred",
              "needs-change"
            ]
          },
          "optionId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ]
          },
          "reviewedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "selected"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "properties": {
                "optionId": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$",
                  "maxLength": 100
                },
                "reviewedAt": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            },
            "else": {
              "properties": {
                "optionId": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "unanswered"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "properties": {
                "reviewedAt": {
                  "type": "null"
                }
              }
            },
            "else": {
              "properties": {
                "reviewedAt": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          }
        ]
      }
    },
    "comments": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claimId",
          "text"
        ],
        "properties": {
          "claimId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$",
            "maxLength": 100
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          }
        }
      }
    }
  }
}
